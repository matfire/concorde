{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".output/**", ".vitepress/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint:fix": {
        "persistent": false,
        "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "cache": true
    }
  }
}
